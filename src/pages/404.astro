---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildUrl } from '@/utils/helpers';
---

<BaseLayout pageTitle="404 - Not Found">
  <div class="error-container">
    <h1 class="error-code">404</h1>
    <p class="error-message">
      Oops — The page you were looking for might have been eaten by an eldritch
      monster!
    </p>
    <a href={buildUrl('')} class="home-button">
      Back home
    </a>
  </div>
</BaseLayout>

<style>
  .error-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
    padding: 2rem;
  }

  .error-code {
    font-size: 6rem;
    font-weight: 900;
    margin: 0;
    background-image: linear-gradient(135deg, var(--theme-color), var(--color-theme-hover));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--theme-color);
    line-height: 1;
  }

  .error-message {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin: 1rem 0 2.5rem;
    font-weight: 500;
  }

  .home-button {
    padding: 0.8rem 2.5rem;
    background-color: var(--primary-color);
    color: white;
    text-decoration: none;
    border-radius: 999px;
    font-weight: 700;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 4px 15px color-mix(in srgb, var(--primary-color) 30%, transparent);
  }

  .home-button:hover {
    transform: scale(1.05) translateY(-2px);
    box-shadow: 0 8px 25px color-mix(in srgb, var(--primary-color) 40%, transparent);
    filter: brightness(1.1);
  }
</style>
